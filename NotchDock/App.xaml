<Application x:Class="NotchDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>

      <!-- 调色板（默认 = 黑色主题；切换主题时由 Theme.Apply 整体替换这些 Brush）
           所有界面颜色都必须走 DynamicResource，否则换主题不会重绘。 -->
      <SolidColorBrush x:Key="FgBrush" Color="#FFEDEDF2" />
      <SolidColorBrush x:Key="FgDimBrush" Color="#FFA0A0AD" />
      <SolidColorBrush x:Key="FgMuteBrush" Color="#FF70707E" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#360A84FF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158" />
      <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="InputBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="InputHoverBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="CheckBorderBrush" Color="#4DFFFFFF" />
      <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="TickBrush" Color="#FF0B1220" />
      <SolidColorBrush x:Key="DotBrush" Color="#FFEDEDF2" />
      <SolidColorBrush x:Key="DotSmallBrush" Color="#FFC0C0C8" />
      <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="OverlayBrush" Color="#FF08080B" />

      <!-- 可点击元素的专用色 -->
      <SolidColorBrush x:Key="SelFgBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="PillHoverBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="ChipBgBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="ChipFgBrush" Color="#FFB6B6C2" />
      <SolidColorBrush x:Key="ChipSelBgBrush" Color="#400A84FF" />
      <SolidColorBrush x:Key="ChipSelFgBrush" Color="#FF8AC2FF" />
      <SolidColorBrush x:Key="BtnFillBrush" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="BtnHoverBrush" Color="#2BFFFFFF" />
      <SolidColorBrush x:Key="BtnDangerHoverBrush" Color="#40FF453A" />

      <!-- 二级菜单 -->
      <SolidColorBrush x:Key="MenuBgBrush" Color="#F51A1A1E" />
      <SolidColorBrush x:Key="MenuBorderBrush" Color="#2BFFFFFF" />
      <SolidColorBrush x:Key="MenuFgBrush" Color="#FFE9E9EF" />
      <SolidColorBrush x:Key="MenuHoverBrush" Color="#FF0A84FF" />
      <SolidColorBrush x:Key="MenuHoverFgBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MenuSepBrush" Color="#1FFFFFFF" />

      <LinearGradientBrush x:Key="SelFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3E9BFF" Offset="0" />
        <GradientStop Color="#FF0A6FF0" Offset="1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="ShellBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF121217" Offset="0" />
        <GradientStop Color="#FF07070B" Offset="0.55" />
        <GradientStop Color="#FF040407" Offset="1" />
      </LinearGradientBrush>

      <BooleanToVisibilityConverter x:Key="BoolVis" />

      <!-- ============ 页签 / 分类胶囊 ============ -->
      <Style x:Key="PillStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.82" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ============ 小按钮（复制 / 固定 / 删 / ＋文件 / ⋯） ============ -->
      <Style x:Key="GhostStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}" />
        <Setter Property="Background" Value="{DynamicResource BtnFillBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 危险动作（删） -->
      <Style x:Key="DangerGhostStyle" TargetType="Button" BasedOn="{StaticResource GhostStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDangerHoverBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ============ 收藏磁贴 ============ -->
      <Style x:Key="TileStyle" TargetType="Button">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="90" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ============ 输入框 ============ -->
      <Style x:Key="DarkInput" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                      Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ============ 圆形勾选 ============ -->
      <Style x:Key="DarkCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="18" Height="18" Background="Transparent">
                <Border x:Name="box" CornerRadius="9" Background="Transparent"
                        BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1.4" />
                <Path x:Name="tick" Data="M1,5 L3.6,7.6 L9,2" Stroke="{DynamicResource TickBrush}" StrokeThickness="1.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{DynamicResource SelFillBrush}" />
                  <Setter TargetName="box" Property="BorderBrush" Value="Transparent" />
                  <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ============ 细滚动条 ============ -->
      <Style x:Key="ThinScroll" TargetType="ScrollBar">
        <Setter Property="Width" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb MinHeight="26">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="2.5" Margin="1,0" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}" />

      <!-- ============ 二级菜单（右键菜单 / ⋯ 菜单 / 子菜单） ============
           这是"macOS 观感"的关键：深色底 + 圆角 + 高亮项整条填蓝、白字。 -->
      <Style TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Margin="7" Padding="0,5" CornerRadius="12"
                      Background="{DynamicResource MenuBgBrush}"
                      BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuFgBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Grid>
                <Border x:Name="bd" CornerRadius="7" Margin="5,1" Padding="10,6" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="15" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path x:Name="check" Grid.Column="0" Data="M1,4.6 L3.8,7.4 L9,1.6"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="10" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                          Visibility="Collapsed" />

                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center" Margin="0,0,14,0" />

                    <Path x:Name="arrow" Grid.Column="2" Data="M0,0 L3.4,3.4 L0,6.8"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Visibility="Collapsed" />
                  </Grid>
                </Border>

                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                       HorizontalOffset="-5" VerticalOffset="-7" PopupAnimation="Fade">
                  <Border Margin="8" Padding="0,5" CornerRadius="12"
                          Background="{DynamicResource MenuBgBrush}"
                          BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Role" Value="SubmenuHeader">
                  <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource MenuHoverFgBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Separator">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Margin="12,4" Background="{DynamicResource MenuSepBrush}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
