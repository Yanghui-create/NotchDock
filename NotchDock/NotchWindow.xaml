<Window x:Class="NotchDock.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchDock"
        Icon="Assets/NotchDock.ico"
        Width="214" Height="30"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="0" Top="0"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        FontSize="13"
        FocusVisualStyle="{x:Null}"
        TextOptions.TextFormattingMode="Ideal">

  <!-- FocusVisualStyle=None：这个窗口是"贴在屏幕上的装饰层"，绝不该出现系统虚线焦点框 -->
  <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
        Focusable="False" FocusVisualStyle="{x:Null}"
        DragOver="Root_DragOver" Drop="Root_Drop">

    <!-- 窗口尺寸 = 刘海尺寸，由动画逐帧同时改「位置+大小」（一次 SetWindowPos），
         所以不会出现"尺寸已变、位置滞后"的错位帧，也不会留下大片透明区挡鼠标。 -->
    <Border x:Name="Shell" Width="214"
            HorizontalAlignment="Center" VerticalAlignment="Stretch"
            Background="{DynamicResource ShellBgBrush}"
            CornerRadius="0,0,24,24" BorderThickness="0,0,1,1"
            BorderBrush="{DynamicResource StrokeBrush}" ClipToBounds="True"
            MouseMove="Shell_DragMove" MouseLeftButtonUp="Shell_DragUp">
      <Grid>

        <!-- ===== 液态玻璃层（只有 Glass 主题才显示）=====
             分层模仿 iOS 26 Liquid Glass：镜面斜向高光 + 顶部弧光 + 底部内缘折射 -->
        <Grid x:Name="GlassLayer" Visibility="Collapsed" IsHitTestVisible="False">
          <Border CornerRadius="0,0,24,24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.12,0" EndPoint="0.88,1">
                <GradientStop Color="#52FFFFFF" Offset="0" />
                <GradientStop Color="#1CFFFFFF" Offset="0.18" />
                <GradientStop Color="#00FFFFFF" Offset="0.48" />
                <GradientStop Color="#0EFFFFFF" Offset="0.72" />
                <GradientStop Color="#1A8FB4FF" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- 顶部那道弧光（玻璃边缘的镜面反射） -->
          <Border Height="2" VerticalAlignment="Top" Margin="20,0,20,0" CornerRadius="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#E0FFFFFF" Offset="0.4" />
                <GradientStop Color="#FFFFFFFF" Offset="0.58" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- 内圈亮线：玻璃板的"厚度" -->
          <Border CornerRadius="0,0,23,23" Margin="1.2"
                  BorderThickness="1" BorderBrush="#5CFFFFFF" />

          <!-- 底部内缘：上半是被玻璃折射压暗的过渡，最底一条是冷色折射 -->
          <Border Height="30" VerticalAlignment="Bottom" CornerRadius="0,0,24,24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00707E9C" Offset="0" />
                <GradientStop Color="#12808EAE" Offset="0.55" />
                <GradientStop Color="#3089A6CC" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- 左侧一道细高光，让"玻璃板"有体积 -->
          <Border Width="1" HorizontalAlignment="Left" Margin="0,10,0,14">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#5AFFFFFF" Offset="0.3" />
                <GradientStop Color="#00FFFFFF" Offset="0.85" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>

        <Grid>

        <!-- ================= 收起态：MacBook 刘海（可按住拖动） ================= -->
        <Grid x:Name="CollapsedLayer" Width="214" Height="30"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Cursor="Hand" MouseLeftButtonDown="CollapsedLayer_MouseLeftButtonDown">
          <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Fill="{DynamicResource DotBrush}" />
        </Grid>

        <!-- ================= 展开态 =================
             内容按"最终展开尺寸"一次性布局好，由外层 Shell 裁剪揭示；
             动画只改变 Shell 的宽高与圆角，内容不重排，所以全程不掉帧。 -->
        <Grid x:Name="ContentHost" Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="660" Height="520">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="ContentShift" Y="-14" />
          </Grid.RenderTransform>
          <Grid x:Name="ExpandedLayer">
            <Grid.RowDefinitions>
              <RowDefinition Height="52" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

          <!-- 顶部页签栏（空白处可按住拖动整个刘海） -->
          <Grid x:Name="DragHandle" Grid.Row="0" Margin="16,0,12,0"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="TabFav" Style="{StaticResource PillStyle}" Content="速览" Tag="0"
                      Click="Tab_Click" Margin="0,0,2,0" />
              <Button x:Name="TabClip" Style="{StaticResource PillStyle}" Content="剪贴板" Tag="1"
                      Click="Tab_Click" Margin="0,0,2,0" />
              <Button x:Name="TabTodo" Style="{StaticResource PillStyle}" Content="待办" Tag="2"
                      Click="Tab_Click" />
            </StackPanel>

            <!-- 右上角：居中显示（让刘海回到屏幕正中）/ 设置（文字按钮）/ 全部清除（仅待办页） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnAction" Style="{StaticResource GhostStyle}" Content="全部清除"
                      Click="BtnAction_Click" Margin="0,0,2,0" />
              <Button x:Name="BtnRecenter" Style="{StaticResource GhostStyle}" Content="居中显示"
                      Click="BtnRecenter_Click" Margin="0,0,2,0" Padding="9,4" FontSize="12"
                      ToolTip="让刘海回到屏幕顶部正中" />
              <Button x:Name="BtnSettings" Style="{StaticResource GhostStyle}" Content="设置"
                      Click="OpenSettings_Click" Padding="9,4" FontSize="12" ToolTip="设置" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">

            <!-- ===== 页1：速览 ===== -->
            <Grid x:Name="PaneFav">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Margin="14,0,14,6" Padding="12,8" CornerRadius="11"
                      Background="{DynamicResource CardBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="FavHint" Grid.Column="0" Text="把文件、文件夹拖进刘海即可收藏"
                             FontSize="11.5" Foreground="{DynamicResource FgMuteBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostStyle}" Content="＋ 文件" Click="AddFiles_Click" Margin="0,0,2,0" />
                    <Button Style="{StaticResource GhostStyle}" Content="＋ 文件夹" Click="AddFolder_Click" Margin="0,0,2,0" />
                    <Button Style="{StaticResource GhostStyle}" Content="＋ 应用" Click="OpenPicker_Click" />
                  </StackPanel>
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="14,0,14,12">
                <StackPanel>
                  <TextBlock x:Name="FileHeader" Text="文件" FontSize="11.5"
                             Foreground="{DynamicResource FgMuteBrush}" Margin="2,2,0,6" />
                  <ItemsControl x:Name="FileList">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource TileStyle}" Tag="{Binding}" Click="Tile_Click"
                                ToolTip="{Binding Target}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="打开" Click="TileMenuOpen_Click" />
                              <MenuItem Header="在资源管理器中显示" Click="TileMenuReveal_Click" />
                              <Separator />
                              <MenuItem Header="移出收藏" Click="TileMenuRemove_Click" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <StackPanel Width="78">
                            <Image Source="{Binding Icon}" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="11" MaxHeight="28"
                                       Foreground="{DynamicResource FgDimBrush}" TextAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="FileEmpty" Text="还没有收藏文件" FontSize="11.5"
                             Foreground="{DynamicResource FgMuteBrush}" Margin="2,0,0,10" Visibility="Collapsed" />

                  <TextBlock x:Name="AppHeader" Text="应用" FontSize="11.5"
                             Foreground="{DynamicResource FgMuteBrush}" Margin="2,8,0,6" />
                  <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource TileStyle}" Tag="{Binding}" Click="Tile_Click"
                                ToolTip="{Binding Target}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="打开" Click="TileMenuOpen_Click" />
                              <MenuItem Header="在资源管理器中显示" Click="TileMenuReveal_Click" />
                              <Separator />
                              <MenuItem Header="移出收藏" Click="TileMenuRemove_Click" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <StackPanel Width="78">
                            <Image Source="{Binding Icon}" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="11" MaxHeight="28"
                                       Foreground="{DynamicResource FgDimBrush}" TextAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="AppEmpty" Text="还没有固定应用，点上方「＋ 应用」从中挑选"
                             FontSize="11.5" Foreground="{DynamicResource FgMuteBrush}" Margin="2,0,0,10" />
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- ===== 页2：剪贴板历史（仿 TieZ） ===== -->
            <Grid x:Name="PaneClip" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- 搜索 + Win+C 接管 + 清空 -->
              <Grid Grid.Row="0" Margin="14,0,14,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <TextBox x:Name="ClipSearch" Style="{StaticResource DarkInput}" Height="34"
                           TextChanged="ClipSearch_TextChanged"
                           GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                  <TextBlock x:Name="ClipSearchHint" Text="搜索复制过的内容…" FontSize="12.5"
                             Foreground="{DynamicResource FgMuteBrush}" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <!-- 只在剪贴板页显示：点了直接接管 Win+V（系统剪贴板历史那组键） -->
                <Button Grid.Column="1" x:Name="BtnWinV" Style="{StaticResource GhostStyle}"
                        Content="Win+V 已接管" Click="BtnWinV_Click" Margin="6,0,0,0" Height="34"
                        FontSize="12" Padding="9,4" />
                <Button Grid.Column="2" Style="{StaticResource GhostStyle}" Content="清空"
                        Click="ClipClear_Click" Margin="6,0,0,0" Height="34" />
              </Grid>

              <!-- 分类 -->
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled" Margin="14,0,14,8">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PillStyle}" Content="全部" Tag="all"
                          FontSize="12" Padding="11,5" Margin="0,0,3,0" Click="ClipFilter_Click" />
                  <Button Style="{StaticResource PillStyle}" Content="文字" Tag="text"
                          FontSize="12" Padding="11,5" Margin="0,0,3,0" Click="ClipFilter_Click" />
                  <Button Style="{StaticResource PillStyle}" Content="图片" Tag="image"
                          FontSize="12" Padding="11,5" Margin="0,0,3,0" Click="ClipFilter_Click" />
                  <Button Style="{StaticResource PillStyle}" Content="文件" Tag="file"
                          FontSize="12" Padding="11,5" Margin="0,0,3,0" Click="ClipFilter_Click" />
                  <Button Style="{StaticResource PillStyle}" Content="URL" Tag="url"
                          FontSize="12" Padding="11,5" Margin="0,0,3,0" Click="ClipFilter_Click" />
                  <Button Style="{StaticResource PillStyle}" Content="代码" Tag="code"
                          FontSize="12" Padding="11,5" Click="ClipFilter_Click" />
                </StackPanel>
              </ScrollViewer>

              <!-- 列表 -->
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,12">
                <ItemsControl x:Name="ClipList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,7" CornerRadius="12" Padding="11,9"
                              Background="{DynamicResource CardBrush}"
                              BorderThickness="1" BorderBrush="Transparent"
                              Cursor="Hand" Tag="{Binding}"
                              ToolTip="点一下就粘贴到刚才的位置"
                              MouseLeftButtonUp="ClipCard_Click">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                              </Trigger>
                              <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>

                        <StackPanel>
                          <!-- 来源行 -->
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                    Background="{Binding KindColor}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding KindGlyph}" FontSize="10" Foreground="#FFFFFFFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Source}" FontSize="11"
                                         Foreground="{DynamicResource FgDimBrush}" />
                              <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource FgMuteBrush}" />
                              <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                         Foreground="{DynamicResource FgMuteBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Style="{StaticResource GhostStyle}" Content="复制" FontSize="11"
                                      Padding="7,2" Tag="{Binding}" Click="ClipCopy_Click" />
                              <Button Style="{StaticResource GhostStyle}" Content="{Binding PinGlyph}" FontSize="11"
                                      Padding="7,2" Margin="2,0,0,0" Tag="{Binding}" Click="ClipPin_Click" />
                              <Button Style="{StaticResource DangerGhostStyle}" Content="删" FontSize="11"
                                      Padding="7,2" Margin="2,0,0,0" Tag="{Binding}" Click="ClipDelete_Click" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{DynamicResource FgMuteBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                          </Grid>

                          <!-- 文本预览 -->
                          <TextBlock Text="{Binding Preview}" FontSize="12.5" Margin="0,7,0,0"
                                     Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap"
                                     MaxHeight="62" TextTrimming="CharacterEllipsis"
                                     Visibility="{Binding ShowText, Converter={StaticResource BoolVis}}" />

                          <!-- 图片缩略图：OnLoad 完全解码 + Freeze（与收藏磁贴同款可靠路径），
                               IsAsync 让首次解码在后台线程跑，不卡列表；点卡片仍是粘贴原图 -->
                          <Border Margin="0,7,0,0" HorizontalAlignment="Left" CornerRadius="9"
                                  Padding="6" Background="{DynamicResource CardHoverBrush}"
                                  Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                              <Image Source="{Binding ThumbSource, IsAsync=True}"
                                     MaxWidth="320" MaxHeight="104"
                                     Stretch="Uniform" StretchDirection="DownOnly"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     HorizontalAlignment="Left" />
                              <TextBlock Margin="2,5,0,0" FontSize="10.5"
                                         Foreground="{DynamicResource FgMuteBrush}"
                                         Text="{Binding ImageSizeText, StringFormat='{}{0} · 点卡片粘贴原图'}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock x:Name="ClipEmpty" Grid.Row="2" Text="还没有复制记录" FontSize="12"
                         Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" IsHitTestVisible="False" />

              <!-- 剪贴板页自己的瞬时提示（FlashHint 会同时写这里和速览页的提示条） -->
              <Border Grid.Row="2" x:Name="ClipHintBox" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,14" Padding="12,7" CornerRadius="9" Visibility="Collapsed"
                      Background="{DynamicResource CardHoverBrush}"
                      BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                <TextBlock x:Name="ClipHint" FontSize="12" Foreground="{DynamicResource FgBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
              </Border>
            </Grid>

            <!-- ===== 页3：待办（企业微信风格） ===== -->
            <Grid x:Name="PaneTodo" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- 输入卡：大输入框 + 发送按钮，下面一行功能键 -->
              <Border Grid.Row="0" Margin="14,0,14,8" Padding="12,10" CornerRadius="14"
                      Background="{DynamicResource CardBrush}" BorderThickness="1"
                      BorderBrush="{DynamicResource StrokeBrush}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                      <TextBox x:Name="TodoTitle" Style="{StaticResource DarkInput}" Height="40"
                               FontSize="13.5" Padding="13,0" AcceptsReturn="False" KeyDown="TodoTitle_KeyDown"
                               GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                      <TextBlock x:Name="TodoTitleHint" Text="写下你的待办事项..." FontSize="13"
                                 Foreground="{DynamicResource FgMuteBrush}" Margin="14,0,0,0"
                                 VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <!-- 蓝色发送按钮（纸飞机） -->
                    <Button Grid.Column="1" Click="AddTodo_Click" Width="40" Height="40" Margin="8,0,0,0"
                            Cursor="Hand" BorderThickness="0" ToolTip="添加待办">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{DynamicResource AccentBrush}" CornerRadius="11">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3,11 L20,4 L13,20 L11,13 Z M11,13 L20,4"
                                  Stroke="{DynamicResource BadgeTextBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"
                                  Margin="0,0,0,0" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                              <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>

                  <!-- 功能键行：截止时间 / 描述 -->
                  <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Button x:Name="TodoDueChip" Style="{StaticResource GhostStyle}" Click="TodoDueChip_Click"
                            Padding="9,5" Margin="0,0,6,0" FontSize="11.5">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◷" FontSize="13" Margin="0,-1,5,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="TodoDueChipText" Text="截止时间" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="TodoDescChip" Style="{StaticResource GhostStyle}" Click="TodoDescChip_Click"
                            Padding="9,5" FontSize="11.5">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="≡" FontSize="14" Margin="0,-2,5,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="描述" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- 描述输入框（点「描述」展开） -->
                  <TextBox x:Name="TodoDesc" Style="{StaticResource DarkInput}" Visibility="Collapsed"
                           Height="58" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                           Padding="12,8" />
                  <!-- 隐藏的 backing 字段：实际截止时间与提醒提前量 -->
                  <TextBox x:Name="TodoDue" Visibility="Collapsed" />
                  <TextBox x:Name="TodoBefore" Visibility="Collapsed" Text="15" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="14,0,14,12">
                <ItemsControl x:Name="TodoList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="11,9" CornerRadius="12" Background="{DynamicResource CardBrush}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox Grid.Column="0" Style="{StaticResource DarkCheck}" VerticalAlignment="Top"
                                    Margin="0,1,0,0" IsChecked="{Binding Done, Mode=TwoWay}" Click="TodoCheck_Click" />
                          <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                      <Setter Property="TextDecorations" Value="Strikethrough" />
                                      <Setter Property="Foreground" Value="{DynamicResource FgMuteBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FgDimBrush}" Margin="0,3,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                              <TextBlock Text="{Binding DueText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                              <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource FgMuteBrush}" />
                              <TextBlock Text="{Binding BeforeText}" FontSize="11" Foreground="{DynamicResource FgDimBrush}" />
                              <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource FgMuteBrush}" />
                              <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource FgMuteBrush}" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Button Style="{StaticResource GhostStyle}" Content="✕" FontSize="11"
                                    Padding="6,3" Click="TodoDelete_Click" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- 空状态：插画 + 文案 -->
              <StackPanel x:Name="TodoEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsHitTestVisible="False">
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                  <Grid>
                    <Path Width="34" Height="34" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,2 L19,2 A2,2 0 0 1 21,4 L21,22 A2,2 0 0 1 19,24 L5,24 A2,2 0 0 1 3,22 L3,4 A2,2 0 0 1 5,2 Z M8,9 L16,9 M8,13 L16,13 M8,17 L13,17" />
                    <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-3,-3" Fill="{DynamicResource AccentBrush}" />
                    <Path Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,1,4" Stroke="{DynamicResource BadgeTextBrush}" StrokeThickness="2.2"
                          StrokeLineJoin="Round" Data="M1,5 L4.5,8.5 L11,1.5" />
                  </Grid>
                </Border>
                <TextBlock Text="随时记录待办，有序处理工作" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,14,0,0" Foreground="{DynamicResource FgBrush}" />
                <TextBlock Text="写下一件事，到点我会提醒你" FontSize="11.5" HorizontalAlignment="Center"
                           Margin="0,5,0,0" Foreground="{DynamicResource FgMuteBrush}" />
              </StackPanel>

              <!-- 底部：状态 + 显示已完成事项 -->
              <Grid Grid.Row="2" Margin="16,0,16,10">
                <TextBlock x:Name="TodoFooter" Text="" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgMuteBrush}" />
                <Button x:Name="TodoShowDone" Style="{StaticResource GhostStyle}" Click="TodoShowDone_Click"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11" Content="▸ 显示已完成" />
              </Grid>
            </Grid>

            <!-- ===== 应用库浮层 ===== -->
            <Border x:Name="PickerOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}"
                    CornerRadius="0,0,24,24">
              <Grid Margin="16,8,16,14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <TextBlock Text="应用库" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                  <Button Style="{StaticResource GhostStyle}" Content="关闭" HorizontalAlignment="Right"
                          Click="ClosePicker_Click" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,10">
                  <TextBox x:Name="PickerSearch" Style="{StaticResource DarkInput}" Height="32"
                           TextChanged="PickerSearch_TextChanged"
                           GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                  <TextBlock x:Name="PickerHint" Text="搜索已安装应用…" FontSize="12.5"
                             Foreground="{DynamicResource FgMuteBrush}" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                  <ItemsControl x:Name="PickerList">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizationMode="Recycling" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Tag="{Binding}" Click="PickerItem_Click" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,2">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="8,6">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                                         RenderOptions.BitmapScalingMode="HighQuality" />
                                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="10,0,0,0"
                                             Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="添加" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                            <Setter Property="Text" Value="已添加" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <!-- 扫描期间的占位提示：扫描在后台线程跑，这一帧 UI 不卡 -->
                <TextBlock x:Name="PickerLoading" Grid.Row="2" Text="正在扫描已安装应用…" FontSize="12.5"
                           Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
              </Grid>
            </Border>

            <!-- ===== 设置浮层 ===== -->
            <Border x:Name="SettingsOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}"
                    CornerRadius="0,0,24,24">
              <Grid Margin="20,10,20,16">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="设置" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                  <Button Grid.Row="0" Style="{StaticResource GhostStyle}" Content="关闭" HorizontalAlignment="Right"
                          Click="CloseSettings_Click" />
                  <TextBlock Grid.Row="1" x:Name="SettingsHint" FontSize="11.5" Margin="1,6,0,0"
                             Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>

                    <!-- 全局快捷键 -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12">
                      <StackPanel>
                        <TextBlock Text="剪贴板快捷键" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgBrush}" />
                        <TextBlock Text="在任意程序里按这组键，直接呼出剪贴板面板。默认接管系统剪贴板历史的 Win+V。"
                                   FontSize="11.5" Foreground="{DynamicResource FgMuteBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,11" />

                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0" CornerRadius="9" Padding="12,7"
                                  Background="{DynamicResource BtnFillBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                            <TextBlock x:Name="HotKeyText" Text="Win + V" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgBrush}" />
                          </Border>

                          <TextBlock x:Name="HotKeyStatus" Grid.Column="1" FontSize="11.5" Margin="11,0,11,0"
                                     VerticalAlignment="Center" TextWrapping="Wrap"
                                     Foreground="{DynamicResource SuccessBrush}" Text="已生效" />

                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRecord" Style="{StaticResource GhostStyle}" Content="录制"
                                    Click="RecordHotKey_Click" />
                            <Button Style="{StaticResource GhostStyle}" Content="恢复默认" Margin="4,0,0,0"
                                    Click="ResetHotKey_Click" />
                          </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                          <CheckBox x:Name="HotKeyToggle" Style="{StaticResource DarkCheck}" VerticalAlignment="Center"
                                    Click="HotKeyToggle_Click" />
                          <TextBlock Text="启用全局快捷键" FontSize="12" Margin="8,0,0,0" Cursor="Hand"
                                     Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center"
                                     MouseLeftButtonUp="HotKeyLabel_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 说明 -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="关于 Win+V 的接管机制" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource FgMuteBrush}"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"
                                   Text="Win+V 默认由系统剪贴板历史占用，直接注册抢不到。接管时会自动写入 Explorer 的官方开关 DisabledHotkeys 并关闭系统剪贴板历史（与开源剪贴板工具 TieZ 的做法相同），再重启一次资源管理器让系统释放这组键——桌面会闪几秒，属正常。副作用是按 Win+V 不再弹出系统历史面板，由本程序顶上。" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Style="{StaticResource GhostStyle}" Content="恢复系统剪贴板历史（撤销接管）"
                                  Click="RevertWinV_Click" FontSize="11.5" Padding="9,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 外观 -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="外观" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgBrush}" />
                        <TextBlock Text="三套主题，切换后立即生效；托盘右键菜单里也能切。"
                                   FontSize="11.5" Foreground="{DynamicResource FgMuteBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="BtnThemeBlack" Style="{StaticResource PillStyle}" Content="黑色"
                                  Tag="black" Click="SettingsTheme_Click" Margin="0,0,3,0" FontSize="12" Padding="11,6" />
                          <Button x:Name="BtnThemeWhite" Style="{StaticResource PillStyle}" Content="白色"
                                  Tag="white" Click="SettingsTheme_Click" Margin="0,0,3,0" FontSize="12" Padding="11,6" />
                          <Button x:Name="BtnThemeGlass" Style="{StaticResource PillStyle}" Content="液态玻璃"
                                  Tag="glass" Click="SettingsTheme_Click" FontSize="12" Padding="11,6" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 通用 -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="通用" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgBrush}" />
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox x:Name="ChkAutoStart" Grid.Column="0" Style="{StaticResource DarkCheck}"
                                    VerticalAlignment="Center" Click="AutoStart_Click" />
                          <TextBlock Grid.Column="1" Text="开机自动启动" FontSize="12" Margin="8,0,0,0" Cursor="Hand"
                                     Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center"
                                     MouseLeftButtonUp="AutoStartLabel_Click" />
                          <Button Grid.Column="2" Style="{StaticResource GhostStyle}" Content="重新扫描已安装应用"
                                  Click="RescanApps_Click" FontSize="11.5" Padding="9,4" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Style="{StaticResource GhostStyle}" Content="打开数据目录" Click="OpenDataDir_Click"
                                  FontSize="11.5" Padding="9,4" Margin="0,0,3,0" />
                          <Button Style="{StaticResource DangerGhostStyle}" Content="退出 NotchDock"
                                  Click="QuitApp_Click" FontSize="11.5" Padding="9,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- ===== 截止时间日历浮层（企业微信风格） ===== -->
              <Border x:Name="DueOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}"
                    CornerRadius="0,0,24,24" MouseLeftButtonDown="DueOverlayBackdrop_Click">
              <Border Width="288" VerticalAlignment="Center" HorizontalAlignment="Center"
                      CornerRadius="14" Padding="13,11" Background="{DynamicResource CardBrush}"
                      BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                      MouseLeftButtonDown="DueCard_Click">
                <StackPanel>
                  <!-- 月份 + 前后切换 -->
                  <Grid Margin="0,0,0,7">
                    <TextBlock x:Name="DueMonthText" Text="2026年11月" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Style="{StaticResource GhostStyle}" Content="‹" FontSize="15" Padding="0"
                              Width="24" Height="22" Click="DuePrevMonth_Click" />
                      <Button Style="{StaticResource GhostStyle}" Content="›" FontSize="15" Padding="0"
                              Width="24" Height="22" Margin="3,0,0,0" Click="DueNextMonth_Click" />
                    </StackPanel>
                  </Grid>

                  <!-- 星期表头 -->
                  <UniformGrid Columns="7" Margin="0,0,0,2">
                    <TextBlock Text="日" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="一" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="二" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="三" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="四" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="五" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="六" FontSize="10.5" Foreground="{DynamicResource FgMuteBrush}" HorizontalAlignment="Center" />
                  </UniformGrid>

                  <!-- 日期网格：由代码动态填充 -->
                  <ItemsControl x:Name="DueDays">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="DueDay_Click" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                Tag="{Binding Date}" Padding="0" Margin="0.5"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="bd" Width="33" Height="27" CornerRadius="8"
                                      Background="{TemplateBinding Background}">
                                <TextBlock x:Name="txt" Text="{Binding Label}" FontSize="11.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgBrush}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                  <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                  <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                  <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource FgMuteBrush}" />
                                  <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 时间 -->
                  <Grid Margin="0,8,0,0">
                    <TextBlock Text="时间" FontSize="11.5" Foreground="{DynamicResource FgDimBrush}"
                               VerticalAlignment="Center" Width="38"
                               HorizontalAlignment="Left" />
                    <TextBox x:Name="DueTimeText" Style="{StaticResource DarkInput}" Height="29"
                             FontSize="11.5" Text="18:00" Margin="38,0,0,0" />
                  </Grid>

                  <!-- 提醒 -->
                  <Grid Margin="0,7,0,0">
                    <TextBlock Text="提醒" FontSize="11.5" Foreground="{DynamicResource FgDimBrush}"
                               VerticalAlignment="Center" Width="38" />
                    <ComboBox x:Name="DueReminder" Height="29" Margin="38,0,0,0" FontSize="11.5"
                              Background="{DynamicResource InputBrush}" Foreground="{DynamicResource FgBrush}"
                              BorderThickness="0" SelectedIndex="2">
                      <ComboBoxItem Content="准时提醒" Tag="0" />
                      <ComboBoxItem Content="提前 5 分钟" Tag="5" />
                      <ComboBoxItem Content="提前 15 分钟" Tag="15" />
                      <ComboBoxItem Content="提前 30 分钟" Tag="30" />
                      <ComboBoxItem Content="提前 1 小时" Tag="60" />
                      <ComboBoxItem Content="提前 2 小时" Tag="120" />
                      <ComboBoxItem Content="提前 3 小时" Tag="180" />
                      <ComboBoxItem Content="提前 1 天" Tag="1440" />
                    </ComboBox>
                  </Grid>

                  <!-- 确定 -->
                  <Button Content="确定" Click="DueConfirm_Click" Height="31" Margin="0,10,0,0"
                          Cursor="Hand" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                          Foreground="{DynamicResource BadgeTextBrush}" Background="{DynamicResource AccentBrush}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </StackPanel>
              </Border>
            </Border>

          </Grid>
        </Grid>
        </Grid>
      </Grid>

      </Grid>
    </Border>
  </Grid>
</Window>
